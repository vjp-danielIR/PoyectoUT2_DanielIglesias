@page "/ticket"
@{
    Layout = null;
    string reservationCode = "RES-0001";
    string product = "Cereza Picota";
    int kilos = 20;
    string pickupPlace = "Cooperativa del Valle del Jerte";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>NovaHarvest - Justificante de reserva</title>
    <link rel="stylesheet" href="/css/site.css">
</head>
<body>
    <h1>Justificante de reserva</h1>
    <p>Reserva: @reservationCode</p>
    <p>Producto: @product</p>
    <p>Kilos: @kilos</p>
    <p>Recogida: @pickupPlace</p>
    <p>Generado el @DateTime.Now.ToString("dd/MM/yyyy HH:mm")</p>
</body>
</html>